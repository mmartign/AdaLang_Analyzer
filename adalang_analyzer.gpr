--  Primary build project: compiles the maintained sources in src and places
--  development artifacts under profile-specific obj and bin directories.

with "config/adalang_analyzer_config.gpr";
project AdaLang_Analyzer is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Adalang_Analyzer_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("adalang_analyzer-driver.adb");

   Common_Switches :=
     Adalang_Analyzer_Config.Ada_Compiler_Switches
     & ("-gnatyM120",  --  Match the project's documented line limit
        "-gnatwe");    --  Reject new compiler warnings

   package Compiler is
      case Adalang_Analyzer_Config.Alire_Host_OS is
         when "windows" =>
            --  Compiled with a section for each subprogram and object, a
            --  unit as large as Flow_Interp has more sections than the
            --  32,767 a COFF object file holds; the big-object format
            --  holds 2**31.
            for Default_Switches ("Ada") use Common_Switches & ("-Wa,-mbig-obj");
         when others =>
            for Default_Switches ("Ada") use Common_Switches;
      end case;
   end Compiler;

   package Builder is
      --  Keep the historical binary name even though the Main source file
      --  is now the child procedure Adalang_Analyzer.Driver.
      for Executable ("adalang_analyzer-driver.adb") use "adalang_analyzer";
   end Builder;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      --  The host is the one Alire found when it wrote the configuration
      --  project.
      case Adalang_Analyzer_Config.Alire_Host_OS is
         when "macos" =>
            --  Homebrew GNAT on recent macOS needs the Command Line Tools
            --  sysroot pointed out explicitly, or the linker cannot find
            --  system libraries.
            for Switches ("Ada") use (
               "-L/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib",
               "-Wl,-syslibroot,/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk",
               "-lgnarl"
            );
         when others =>
            for Switches ("Ada") use ("-lgnarl");
      end case;
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end AdaLang_Analyzer;
