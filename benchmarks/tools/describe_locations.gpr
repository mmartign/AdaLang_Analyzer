with "../../adalang_analyzer.gpr";

--  A helper for the benchmark ledgers, not part of the analyzer: it says
--  what construct each of a list of source locations is in.
project Describe_Locations is

   for Source_Dirs use (".");
   for Object_Dir use "../../obj/describe-locations";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "../../bin";
   for Main use ("describe_locations.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-g", "-O0", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatyM120");
   end Compiler;

   --  Linked as the analyzer is.
   package Linker renames AdaLang_Analyzer.Linker;

end Describe_Locations;
