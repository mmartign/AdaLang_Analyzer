with "../adalang_analyzer.gpr";

project Control_Flow_Graph_Model is

   for Source_Dirs use (".");
   for Object_Dir use "../obj/control-flow-graph-model-test";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "../bin";
   for Main use ("control_flow_graph_model_test.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-g", "-O0", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatyM120");
   end Compiler;

   package Linker is
      for Switches ("Ada") use AdaLang_Analyzer.Linker_Switches;
   end Linker;

end Control_Flow_Graph_Model;
