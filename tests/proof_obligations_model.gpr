with "../adalang_analyzer.gpr";

project Proof_Obligations_Model is

   type OS_Kind is ("linux", "macos", "windows");
   Host_OS : OS_Kind := external ("ADALANG_ANALYZER_OS", "linux");

   for Source_Dirs use (".");
   for Object_Dir use "../obj/proof-obligations-model-test";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "../bin";
   for Main use ("proof_obligations_model_test.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-g", "-O0", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatyM120");
   end Compiler;

   package Linker is
      case Host_OS is
         when "macos" =>
            for Switches ("Ada") use (
               "-L/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib",
               "-Wl,-syslibroot,/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk",
               "-lgnarl"
            );
         when others =>
            for Switches ("Ada") use ("-lgnarl");
      end case;
   end Linker;

end Proof_Obligations_Model;
