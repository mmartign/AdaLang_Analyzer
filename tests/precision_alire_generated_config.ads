--  Configuration for precision_alire_generated generated by Alire
pragma Restrictions (No_Elaboration_Code);
pragma Style_Checks (Off);

--  A copy, under its own crate name, of the configuration file Alire
--  generates (config/<crate>_config.ads): its pragmas are build metadata,
--  not extensions the authors chose, so No_Compiler_Extensions must stay
--  clean on it. The repository's own config/adalang_analyzer_config.ads is
--  generated by the build and not tracked, so the precision corpus cannot
--  rely on it.

package Precision_Alire_Generated_Config is
   pragma Pure;

   Crate_Version : constant String := "1.0.0";
   Crate_Name : constant String := "precision_alire_generated";

   Alire_Host_OS : constant String := "linux";

   Alire_Host_Arch : constant String := "x86_64";

   Alire_Host_Distro : constant String := "ubuntu";

   type Build_Profile_Kind is (release, validation, development);
   Build_Profile : constant Build_Profile_Kind := development;

end Precision_Alire_Generated_Config;
